#!/usr/bin/env bash
# Deprecated. Renamed to `omlx-claude` in 0.3.0.
#
# This shim exists because the old name is already sitting in people's ~/bin —
# the README used to tell them to copy it there by hand — and scripts may call
# it. It forwards everything and will be REMOVED IN 0.4.0.
#
# The replacement is not a rename of this file. `omlx-claude` is a compiled
# command shipped as a release asset and installed by the plugin, and it fixes
# things this script got wrong: it probes the address --host/--port actually
# select rather than always 127.0.0.1:8000, it covers the launcher's fixed
# environment keys instead of only four of them, it reports the model-dependent
# keys it cannot cover, and it says something when oMLX moves past the version
# the workaround was verified against.

set -euo pipefail

echo "claude-local: deprecated — renamed to 'omlx-claude'. This shim is removed in 0.4.0." >&2

if command -v omlx-claude >/dev/null 2>&1; then
    exec omlx-claude "$@"
fi

cat >&2 <<'EOF'
claude-local: omlx-claude is not installed.

  Plugin users:  it installs automatically at session start; start a new session.
  Everyone else: download it from
                 https://github.com/PsychQuant/omlx-connector/releases
                 into ~/bin and `chmod +x` it.
  From a clone:  make install-omlx-claude
EOF
exit 1
